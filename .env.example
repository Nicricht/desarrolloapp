# Solo para tu equipo. No subir el archivo real .env a GitHub.
# Estas URI deben corresponder exactamente al cluster Atlas original.
# Para no copiar credenciales manualmente, ejecuta scripts/iniciar-duoc.ps1
# y selecciona el ZIP ORIGINAL del backend cuando se solicite.
ATLAS_ROLES_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER/segurosbpo_roles
ATLAS_USUARIOS_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER/segurosbpo_usuarios
ATLAS_CATALOGOS_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER/segurosbpo_catalogos
ATLAS_SINIESTROS_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER/segurosbpo_siniestros
